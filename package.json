{
  "name": "voicechatglm-frontend",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.16.0 <21 || >=22.3.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "proxy": "node server/index.cjs",
    "migrate": "node server/db/migrate.cjs",
    "validate:config": "node scripts/validate-config.mjs",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "scan:bundle": "node scripts/scan-build-secrets.mjs",
    "validate:render": "node scripts/validate-render-blueprint.mjs",
    "validate:api-contract": "node scripts/validate-api-contract.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "@napi-rs/canvas": "0.1.100",
    "@tesseract.js-data/eng": "1.0.0",
    "argon2": "^0.45.1",
    "busboy": "^1.6.0",
    "csv-parse": "^7.0.3",
    "fast-xml-parser": "^5.11.2",
    "htmlparser2": "12.0.0",
    "image-size": "^2.0.4",
    "jszip": "3.10.1",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "5.4.149",
    "pg": "^8.23.1",
    "pptxgenjs": "4.0.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "redis": "4.7.0",
    "tesseract.js": "5.1.1",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@testing-library/user-event": "14.5.2",
    "@types/node": "22.10.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "ajv": "^8.20.0",
    "jsdom": "25.0.1",
    "pdf-lib": "1.17.1",
    "pg-mem": "^3.0.5",
    "typescript": "5.7.2",
    "vite": "^6.4.3",
    "vitest": "^4.1.11",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "pptxgenjs": {
      "image-size": "2.0.4"
    }
  }
}
